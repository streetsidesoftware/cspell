{
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "allowImportingTsExtensions": false,
        "rootDir": ".",
        "outDir": ".",
        "types": ["node"],
        "declarationMap": false,
        // tsdown's type declarations import optional peer dependencies that aren't installed.
        "skipLibCheck": true
    },
    "files": ["config.ts"]
}
