{
  "name": "cspell",
  "version": "10.3.5",
  "description": "A Spelling Checker for Code!",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://cspell.org/",
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell.git",
    "directory": "packages/cspell"
  },
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell/issues?q=is%3Aissue%20state%3Aopen%20label%3Acspell"
  },
  "funding": "https://github.com/streetsidesoftware/cspell?sponsor=1",
  "keywords": [
    "spell",
    "checker",
    "code",
    "camel",
    "case",
    "spelling",
    "spell checker",
    "spelling checker",
    "lint"
  ],
  "license": "MIT",
  "author": "Jason Dent",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/commonJsApi.cjs"
    },
    "./app": {
      "import": "./dist/esm/app.js"
    },
    "./bin": {
      "import": "./bin.mjs"
    },
    "./bin.mjs": {
      "import": "./bin.mjs"
    },
    "./application": {
      "import": "./dist/esm/application.js"
    }
  },
  "main": "dist/cjs/commonJsApi.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/commonJsApi.d.cts",
  "bin": {
    "cspell": "bin.mjs",
    "cspell-esm": "bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist",
    "!**/__mocks__",
    "!**/*.map",
    "!**/*.perf.*",
    "!**/*.spec.*",
    "!**/*.test.*",
    "!**/*.tsbuildInfo",
    "!**/perf/**",
    "!**/test/**",
    "!dist/tsc"
  ],
  "scripts": {
    "build": "tsdown && pnpm build:tsc",
    "build:readme": "pnpm build:readme:help",
    "build:readme:help": "pnpm build:readme:help:lint && pnpm build:readme:help:trace && inject-markdown README.md && prettier -w README.md",
    "build:readme:help:lint": "./bin.mjs lint --help > static/help-lint.txt",
    "build:readme:help:trace": "./bin.mjs trace --help > static/help-trace.txt",
    "build:tsc": "tsc -p .",
    "clean": "shx rm -rf dist temp coverage \"*.tsbuildInfo\"",
    "clean-build": "pnpm run clean && pnpm run build",
    "compile": "tsc -p .",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run clean-build",
    "test": "vitest run",
    "test:update-snapshot": "vitest run --update",
    "test:watch": "vitest",
    "test-watch": "vitest",
    "version": "node ./tools/patch-version.mjs && git add .",
    "watch": "tsdown -w",
    "watch:tsc": "tsc -p . -w"
  },
  "dependencies": {
    "@cspell/cspell-json-reporter": "workspace:*",
    "@cspell/cspell-performance-monitor": "workspace:*",
    "@cspell/cspell-pipe": "workspace:*",
    "@cspell/cspell-types": "workspace:*",
    "@cspell/cspell-worker": "workspace:*",
    "@cspell/dynamic-import": "workspace:*",
    "@cspell/url": "workspace:*",
    "ansi-regex": "^6.3.0",
    "chalk": "^6.0.0",
    "chalk-template": "^1.1.2",
    "commander": "^15.0.0",
    "cspell-config-lib": "workspace:*",
    "cspell-dictionary": "workspace:*",
    "cspell-gitignore": "workspace:*",
    "cspell-glob": "workspace:*",
    "cspell-io": "workspace:*",
    "cspell-lib": "workspace:*",
    "flatted": "^3.4.4",
    "semver": "^7.8.5",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/semver": "^7.8.0",
    "micromatch": "^4.0.8",
    "minimatch": "^9.0.9"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
