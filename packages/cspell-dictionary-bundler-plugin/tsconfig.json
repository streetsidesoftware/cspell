{
    "extends": "../../tsconfig.esm.json",
    "compilerOptions": {
        "noEmit": true,
        "rootDir": ".",
        "outDir": "dist",
        "isolatedDeclarations": true,
        "allowImportingTsExtensions": true,
        "types": ["node"],
        // unplugin's type declarations import every bundler it supports, and most aren't installed.
        "skipLibCheck": true
    },
    "include": ["src", "tests"]
}
