{
  "name": "cspell-lib",
  "version": "10.4.0-alpha.1",
  "description": "A library of useful functions used across various cspell tools.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/streetsidesoftware/cspell/tree/main/packages/cspell-lib#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell.git",
    "directory": "packages/cspell-lib"
  },
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell/issues?q=is%3Aissue%20state%3Aopen%20label%3Acspell-lib"
  },
  "keywords": [
    "spell",
    "checker",
    "code",
    "camel",
    "case",
    "spelling",
    "spell checker",
    "spelling checker",
    "lint"
  ],
  "license": "MIT",
  "author": "Jason Dent",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./rpc": {
      "import": "./dist/rpc.js"
    },
    "./cspell-rpc": {
      "import": "./dist/cspell-rpc/index.js"
    },
    "./cspell-rpc/server": {
      "import": "./dist/cspell-rpc/server.js"
    },
    "./cspell-rpc/client": {
      "import": "./dist/cspell-rpc/client.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!**/*.tsbuildInfo",
    "!**/__mocks__",
    "!**/test*/**",
    "!**/test.*",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.map"
  ],
  "scripts": {
    "build": "tsc -p . && pnpm run build:api",
    "build:api": "tsdown",
    "clean": "shx rm -rf dist temp coverage \"*.tsbuildInfo\"",
    "clean-build": "pnpm clean && pnpm build",
    "coverage": "vitest run --coverage --pool=forks",
    "prepublishOnly": "pnpm run clean-build",
    "test": "vitest run --pool=forks",
    "test:perf": "NODE_ENV=production insight --file \"**/*.perf.{mjs,js}\"",
    "test:perf:prof": "NODE_ENV=production node --cpu-prof ../../node_modules/perf-insight/bin.mjs --file \"dist/**/*.perf.{mjs,js}\" -t 1000",
    "test:perf:ts": "NODE_ENV=production insight --file \"**/*.perf.{mts,ts}\" ",
    "test:update-snapshot": "vitest run -u",
    "test-watch": "vitest",
    "watch": "tsc -p . --watch"
  },
  "dependencies": {
    "@cspell/cspell-bundled-dicts": "workspace:*",
    "@cspell/cspell-performance-monitor": "workspace:*",
    "@cspell/cspell-pipe": "workspace:*",
    "@cspell/cspell-resolver": "workspace:*",
    "@cspell/cspell-types": "workspace:*",
    "@cspell/dynamic-import": "workspace:*",
    "@cspell/filetypes": "workspace:*",
    "@cspell/rpc": "workspace:*",
    "@cspell/strong-weak-map": "workspace:*",
    "@cspell/url": "workspace:*",
    "cspell-config-lib": "workspace:*",
    "cspell-dictionary": "workspace:*",
    "cspell-glob": "workspace:*",
    "cspell-grammar": "workspace:*",
    "cspell-io": "workspace:*",
    "cspell-trie-lib": "workspace:*",
    "env-paths": "^4.0.0",
    "gensequence": "^8.0.8",
    "import-fresh": "^4.0.1",
    "resolve-from": "^5.0.0",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-uri": "^3.2.0",
    "xdg-basedir": "^5.1.0"
  },
  "devDependencies": {
    "@cspell/dict-cpp": "^7.1.2",
    "@cspell/dict-csharp": "^4.0.8",
    "@cspell/dict-css": "^4.1.2",
    "@cspell/dict-en_us": "^4.4.40",
    "@cspell/dict-fa-ir": "^4.0.5",
    "@cspell/dict-fr-fr": "^2.3.2",
    "@cspell/dict-html": "^4.0.16",
    "@cspell/dict-nl-nl": "^2.4.2",
    "@cspell/dict-python": "^4.5.2",
    "@cspell/dict-th-th": "^1.0.2",
    "@cspell/dictionary-bundler-plugin": "workspace:*",
    "@types/configstore": "^6.0.2",
    "comment-json": "^5.0.0",
    "configstore": "^8.0.0",
    "cspell-dict-nl-nl": "^1.1.2",
    "leaked-handles": "^5.2.0",
    "lorem-ipsum": "^3.0.0",
    "perf-insight": "^2.0.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
