{
  "name": "@cspell/cspell-resolver",
  "version": "10.3.5",
  "description": "Library to help resolve module locations.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/streetsidesoftware/cspell/tree/main/packages/cspell-resolver#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell.git",
    "directory": "packages/cspell-resolver"
  },
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell/issues?q=is%3Aissue%20state%3Aopen%20label%3Acspell-resolver"
  },
  "keywords": [
    "cspell",
    "resolve"
  ],
  "license": "MIT",
  "author": "Jason Dent <jason@streetsidesoftware.nl>",
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    }
  },
  "directories": {
    "dist": "dist"
  },
  "files": [
    "dist",
    "!**/*.tsbuildInfo",
    "!**/__mocks__",
    "!**/*.spec.*",
    "!**/*.test.*",
    "!**/test/**",
    "!**/*.map"
  ],
  "scripts": {
    "build": "tsc -p .",
    "clean": "shx rm -rf dist temp coverage \"*.tsbuildInfo\"",
    "clean-build": "pnpm run clean && pnpm run build",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test-watch": "vitest",
    "watch": "tsc -p . -w"
  },
  "dependencies": {
    "global-directory": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
