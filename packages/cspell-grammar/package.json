{
  "name": "cspell-grammar",
  "version": "10.3.5",
  "description": "Grammar parsing support for cspell",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/streetsidesoftware/cspell/tree/main/packages/cspell-grammar#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell.git",
    "directory": "packages/cspell-grammar"
  },
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell/issues?q=is%3Aissue%20state%3Aopen%20label%3Acspell-grammar"
  },
  "keywords": [
    "cspell",
    "grammar"
  ],
  "license": "MIT",
  "author": "Jason Dent <jason@streetsidesoftware.nl>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./parsers/typescript": {
      "import": "./dist/parsers/typescript/index.js"
    }
  },
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "index.js": [
        "dist/index.d.ts"
      ],
      "index.d.ts": [
        "dist/index.d.ts"
      ],
      "dist/*.d.ts": [
        "dist/*.d.ts"
      ],
      "parsers": [
        "dist/parsers/index.d.ts"
      ],
      "parsers/typescript": [
        "dist/parsers/typescript/index.d.ts"
      ],
      "parsers/typescript/*.d.ts": [
        "dist/parsers/typescript/*.d.ts"
      ],
      "*": [
        "dist/*.d.ts",
        "dist/*/index.d.ts"
      ]
    }
  },
  "bin": {
    "cspell-grammar": "bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist",
    "!**/*.tsbuildInfo",
    "!**/__mocks__",
    "!**/test/**",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.map"
  ],
  "scripts": {
    "build": "tsc -p .",
    "clean": "shx rm -rf dist temp coverage \"*.tsbuildInfo\"",
    "clean-build": "pnpm run clean && pnpm run build",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch": "tsc -p . -w"
  },
  "dependencies": {
    "@cspell/cspell-pipe": "workspace:*",
    "@cspell/cspell-types": "workspace:*"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
