{
  "name": "@cspell/cspell-service-bus",
  "version": "10.3.6",
  "description": "A Library for connecting requests to services that can fulfill them.",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/streetsidesoftware/cspell/tree/main/packages/cspell-service-bus#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell.git",
    "directory": "packages/cspell-service-bus"
  },
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell/issues?q=is%3Aissue%20state%3Aopen%20label%3Acspell-service-bus"
  },
  "keywords": [
    "cspell"
  ],
  "license": "MIT",
  "author": "Jason Dent <jason@streetsidesoftware.nl>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js"
    }
  },
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "files": [
    "dist",
    "!**/*.tsbuildInfo",
    "!**/__mocks__",
    "!**/*.spec.*",
    "!**/*.test.*",
    "!**/test/**",
    "!**/*.map"
  ],
  "scripts": {
    "build": "tsc -p .",
    "build:clean": "pnpm run clean && pnpm run build",
    "clean": "shx rm -rf dist temp coverage \"*.tsbuildInfo\"",
    "clean-build": "pnpm build:clean",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test-watch": "vitest --watch",
    "watch": "tsc -p . -w"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
