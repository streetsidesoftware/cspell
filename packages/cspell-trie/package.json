{
  "name": "cspell-trie",
  "version": "10.3.5",
  "description": "Trie Data Structure reader for cspell",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/streetsidesoftware/cspell/tree/main/packages/cspell-trie#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell.git",
    "directory": "packages/cspell-trie"
  },
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell/issues?q=is%3Aissue%20state%3Aopen%20label%3Acspell-trie"
  },
  "keywords": [
    "trie",
    "cspell"
  ],
  "license": "MIT",
  "author": "Jason Dent",
  "sideEffects": false,
  "type": "module",
  "bin": {
    "cspell-trie": "bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "!**/*.tsbuildInfo",
    "!**/__mocks__",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.map"
  ],
  "scripts": {
    "build": "tsc -p .",
    "clean": "shx rm -rf dist temp coverage \"*.tsbuildInfo\"",
    "clean-build": "pnpm run clean && pnpm run build",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test-watch": "vitest",
    "watch": "tsc -w"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "cspell-trie-lib": "workspace:*",
    "gensequence": "^8.0.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
