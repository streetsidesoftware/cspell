{
  "name": "@cspell/cspell-tools",
  "version": "10.4.0-alpha.1",
  "description": "Tools to assist with the development of cSpell",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/streetsidesoftware/cspell/tree/main/packages/cspell-tools#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/streetsidesoftware/cspell.git",
    "directory": "packages/cspell-tools"
  },
  "bugs": {
    "url": "https://github.com/streetsidesoftware/cspell/issues?q=is%3Aissue%20state%3Aopen%20label%3Acspell-tools"
  },
  "keywords": [
    "cSpell",
    "Word",
    "List",
    "Compiler"
  ],
  "license": "MIT",
  "author": "Jason Dent",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs"
    },
    "./bin": {
      "import": "./bin.mjs"
    },
    "./bin.mjs": {
      "import": "./bin.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "bin": {
    "cspell-tools": "bin.mjs",
    "cspell-tools-cli": "bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist",
    "cspell-tools.config.schema.json",
    "!**/*.tsbuildInfo",
    "!**/__mocks__",
    "!**/*.test.*",
    "!**/*.spec.*",
    "!**/*.map"
  ],
  "scripts": {
    "build": "pnpm run build-schema && pnpm run compile && pnpm build:check",
    "build:check": "tsc -p .",
    "build-schema": "ts-json-schema-generator --no-top-ref --path src/config/config.ts --type RunConfig --validation-keywords deprecated --markdown-description  -o  ./cspell-tools.config.schema.json",
    "clean": "shx rm -rf dist temp coverage \"*.tsbuildInfo\"",
    "clean-build": "pnpm run clean && pnpm run build",
    "compile": "tsdown",
    "coverage": "vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-snapshot": "vitest run -u",
    "watch": "tsdown -w"
  },
  "dependencies": {
    "@cspell/cspell-pipe": "workspace:*",
    "commander": "^15.0.0",
    "cosmiconfig": "10.0.1",
    "cspell-trie-lib": "workspace:*",
    "glob": "^13.0.6",
    "hunspell-reader": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "lorem-ipsum": "^3.0.0",
    "ts-json-schema-generator": "2.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
