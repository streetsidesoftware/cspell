// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`getReporter > saves xml to console { outFile: 'stderr' } 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<testsuites name="cspell" tests="2" failures="1" errors="1" time="0.349">
  <testsuite name="text.txt" tests="1" failures="1" errors="0" time="0.349">
    <testcase name="fulll (1:14)" classname="text.txt">
      <failure type="spelling" message="Unknown word: &quot;fulll&quot;">Unknown word: "fulll"</failure>
    </testcase>
  </testsuite>
  <testsuite name="cspell-errors" tests="1" failures="0" errors="1" time="0.000">
    <testcase name="something went wrong" classname="cspell">
      <error type="error" message="oh geez">oh geez</error>
    </testcase>
  </testsuite>
</testsuites>
"
`;

