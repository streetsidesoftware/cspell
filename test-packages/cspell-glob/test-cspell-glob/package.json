{
  "name": "test-cspell-glob",
  "version": "9.0.2",
  "description": "Pure testing package for cspell-io. Its purpose is to verify cspell-io dependencies.",
  "private": true,
  "bin": {
    "test-mjs": "./bin.mjs",
    "test-tsdown-cjs": "./bin.tsdown.cjs",
    "test-tsdown-mjs": "./bin.tsdown.mjs"
  },
  "type": "module",
  "scripts": {
    "clean": "shx rm -rf dist",
    "build": "pnpm build:ts && tsdown",
    "build:ts": "pnpm run compile && ts2mjs dist/esm",
    "clean-build": "pnpm run clean && pnpm run build",
    "compile": "tsc -b .  -f",
    "test": "pnpm test:unit && pnpm test:smoke",
    "test:smoke": "node ./bin.mjs && node ./bin.tsdown.mjs && node ./bin.tsdown.cjs",
    "test:unit": "vitest run"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cspell-glob": "workspace:*"
  },
  "keywords": []
}
